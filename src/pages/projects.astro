---
import Layout from "../layouts/Layout.astro";
import { PROJECTS } from "../config/Projects";

const page = {
  title: "Projects · Varun Sahni",
  desc: "Everything Varun Sahni has built: systems, web, open source, and fun stuff.",
};

const link = "underline decoration-rule decoration-1 underline-offset-[3px] hover:decoration-ink";
---

<Layout title={page.title} description={page.desc}>
  <main class="mx-auto flex max-w-[600px] flex-col gap-10 px-5 pb-20 pt-20 sm:pt-28">
    <header class="flex flex-col gap-1">
      <a href="/" class="text-base italic text-muted hover:text-ink">← Varun Sahni</a>
      <h1 class="text-[34px] font-medium leading-tight tracking-tight">Projects</h1>
      <p class="italic text-muted">Systems, web, open source, and fun stuff.</p>
    </header>

    <label for="q" class="sr-only">Search projects</label>
    <input
      id="q"
      type="search"
      placeholder="Search by name, stack, or description"
      class="w-full border-b border-rule bg-transparent pb-2 italic outline-none placeholder:text-muted focus:border-ink"
    />

    <ul id="list" class="flex flex-col gap-7">
      {
        PROJECTS.map((p) => (
          <li class="flex flex-col gap-1">
            <div class="flex items-baseline gap-2.5">
              <a class={link} href={p.link} target="_blank" rel="noopener noreferrer">
                {p.name}
              </a>
              <span class="flex-1 min-w-4 -translate-y-[5px] border-b border-dotted border-rule" />
              <span class="flex shrink-0 gap-3 text-base text-muted">
                {p.extra?.map((x) => (
                  <a class="hover:text-ink" href={x.u} target="_blank" rel="noopener noreferrer">
                    {x.t.toLowerCase()}
                  </a>
                ))}
                {p.source && (
                  <a class="hover:text-ink" href={p.source} target="_blank" rel="noopener noreferrer">
                    source
                  </a>
                )}
              </span>
            </div>
            <p>{p.blurb}</p>
            {p.stack && <p class="text-base italic text-muted">{p.stack.join(", ")}</p>}
          </li>
        ))
      }
    </ul>
  </main>

  <script is:inline>
    const input = document.getElementById("q");
    const items = Array.from(document.getElementById("list")?.children || []);

    input?.addEventListener("input", (e) => {
      const q = (e.target.value || "").toLowerCase().trim();
      items.forEach((li) => {
        li.hidden = q !== "" && !li.textContent.toLowerCase().includes(q);
      });
    });
  </script>
</Layout>
