---
import fs from "node:fs";
import Entry from "../components/Entry.astro";
import Layout from "../layouts/Layout.astro";

const me = {
  email: "contact@vsahni.me",
  github: "https://github.com/notskamr",
  site: "https://vsahni.me",
  blog: "https://blog.vsahni.me",
  resume: "/resume",
};

const work = [
  { name: "CompSi, Purdue", note: "undergraduate researcher", meta: "2026", href: "https://engineering.purdue.edu/compsi" },
  { name: "Paasa", note: "software engineer intern", meta: "2026", href: "https://paasa.com" },
  { name: "CortX", note: "co-founder", meta: "2022", href: "https://urls.vsahni.me/cortx" },
  { name: "The Shri Ram School", note: "head of ICT", meta: "2023", href: "https://tsrs.tech" },
];

const made = [
  { name: "Flux", note: "SSE for serverless", meta: "Bun", href: "https://flux.vsahni.me" },
  { name: "bun-sqlite-cache", note: "1K+ downloads", meta: "npm", href: "https://www.npmjs.com/package/bun-sqlite-cache" },
  { name: "CS61CPU", note: "5-stage RISC-V", meta: "Logisim", href: "https://inst.eecs.berkeley.edu/~cs61c/su23/projects/proj3/" },
  { name: "Crypt Hunt", note: "1.5M requests", meta: "Workers", href: "https://crypthunt.tsrs.tech" },
  { name: "KageMod", note: "23K downloads", meta: "Java", href: "https://www.curseforge.com/minecraft/mc-mods/kagemod" },
];

const writing = [
  {
    name: "Putting the serverless in server-sent events",
    meta: "blog",
    href: "https://blog.vsahni.me/posts/putting-the-serverless-in-server-sent-events",
  },
  { name: "A lightweight CNN for GI disorder detection", note: "IEEE", meta: "2026", href: "https://ieeexplore.ieee.org/document/11613903" },
];

const description =
  "Varun Sahni studies Computer Engineering at Purdue. He builds backend systems, and lately the hardware underneath them.";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Varun Sahni",
  url: me.site,
  email: `mailto:${me.email}`,
  description,
  affiliation: { "@type": "CollegeOrUniversity", name: "Purdue University" },
  sameAs: [me.github, me.blog],
};

// images live in public/photos; a row of three moments, then a row of two views
type Photo = { src: string; caption: string; alt: string; w: number; h: number };
const exists = (p: Photo) => fs.existsSync(`public${p.src}`);
const moments: Photo[] = [
  {
    src: "/photos/buldak.jpg",
    caption: "The spiciest buldak, at Berkeley",
    alt: "A paper bowl of the spiciest buldak noodles, covered in dark chili sauce, with chopsticks",
    w: 903,
    h: 1200,
  },
  {
    src: "/photos/dispenser.jpg",
    caption: "A cardboard medicine dispenser",
    alt: "A cardboard box with two buttons and a blue LCD reading Fri 17:44, A=cycle, B=done",
    w: 901,
    h: 1200,
  },
  {
    src: "/photos/minecraft.jpg",
    caption: "Beating Minecraft, ten years in",
    alt: "A laptop showing the Minecraft end poem on a starry screen",
    w: 1200,
    h: 903,
  },
].filter(exists);
const views: Photo[] = [
  {
    src: "/photos/sunset.jpg",
    caption: "Sunset at Purdue",
    alt: "The sun setting over a campus street, framed by trees and a brick residence hall",
    w: 1051,
    h: 1400,
  },
  {
    src: "/photos/sand.jpg",
    caption: "Life is good",
    alt: "The words life is good and a smiley face written in dark sand",
    w: 1051,
    h: 1400,
  },
].filter(exists);

const label = "mb-2 text-base font-medium tracking-[0.14em] lowercase [font-variant:small-caps] text-muted";
const link = "underline decoration-rule decoration-1 underline-offset-[3px] hover:decoration-ink";
---

<Layout title="Varun Sahni" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />

  <main class="mx-auto flex max-w-[600px] flex-col gap-14 px-5 pb-20 pt-20 sm:pt-28 [font-variant-numeric:oldstyle-nums]">
    <section class="flex flex-col gap-6">
      <header class="flex flex-col gap-1">
        <h1 class="text-[34px] font-medium leading-tight tracking-tight">Varun Sahni</h1>
        <p class="italic text-muted">Computer Engineering at Purdue, class of ’28</p>
      </header>
      <p>
        I build backend systems, and lately the hardware underneath them. I’m an
        undergraduate researcher in Purdue’s
        <a class={link} href="https://engineering.purdue.edu/compsi" target="_blank" rel="noopener noreferrer">CompSi</a> group, working on RISC-V
        vector cores and ML accelerators. I keep things
        <a class={link} href="https://grugbrain.dev/" target="_blank" rel="noopener noreferrer">simple</a>
        on purpose.
      </p>
      <p>
        This summer I was an engineer at
        <a class={link} href="https://paasa.com" target="_blank" rel="noopener noreferrer">Paasa</a> (YC S24), where I built services
        for the trading platform, an execution layer that saved the ops team
        200+ hours a week, and their first FIX engine. Before that, I spent high
        school starting things: a health startup, a symposium for 90+ schools,
        and a programming contest about speed.
      </p>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class={label}>work</h2>
      {work.map((e) => <Entry {...e} />)}
    </section>

    <section class="flex flex-col gap-2">
      <h2 class={label}>things i made</h2>
      {made.map((e) => <Entry {...e} />)}
      <a href="/projects" class="text-[17px] italic text-muted hover:text-ink">all projects →</a>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class={label}>writing</h2>
      {writing.map((e) => <Entry {...e} />)}
    </section>

    {
      moments.length + views.length > 0 && (
        <section class="flex flex-col gap-5">
          {[moments, views].filter((row) => row.length).map((row) => (
            <div class:list={["grid gap-3.5", row.length === 3 ? "grid-cols-3" : "grid-cols-2"]}>
              {row.map((p) => (
                <figure class="flex flex-col gap-1.5">
                  <img
                    src={p.src}
                    alt={p.alt}
                    width={p.w}
                    height={p.h}
                    loading="lazy"
                    decoding="async"
                    class:list={["w-full object-cover", row.length === 3 ? "aspect-square" : "aspect-[4/5]"]}
                  />
                  <figcaption class="text-[15px] italic leading-snug text-muted">{p.caption}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </section>
      )
    }

    <section class="flex flex-col gap-2">
      <h2 class={label}>favorites</h2>
      <dl class="grid grid-cols-[minmax(0,9rem)_minmax(0,1fr)] gap-x-5 gap-y-1.5">
        <dt class="italic text-muted">Listening to</dt>
        <dd id="np" class="italic text-muted" aria-live="polite">checking…</dd>
        <dt class="italic text-muted">Essay</dt>
        <dd><a class={link} href="https://grugbrain.dev/" target="_blank" rel="noopener noreferrer">The Grug Brained Developer</a></dd>
        <dt class="italic text-muted">Album</dt>
        <dd>Mr. Morale &amp; the Big Steppers</dd>
        <dt class="italic text-muted">Movie</dt>
        <dd>Spider-Man: Into the Spider-Verse</dd>
        <dt class="italic text-muted">Games</dt>
        <dd>Red Dead Redemption 2, Minecraft</dd>
        <dt class="italic text-muted">Food</dt>
        <dd>Biryani</dd>
      </dl>
    </section>

    <footer class="flex flex-wrap gap-x-5 gap-y-2 border-t border-rule pt-5 text-base text-muted">
      <a class="hover:text-ink" href={`mailto:${me.email}`}>{me.email}</a>
      <a class="hover:text-ink" href={me.github} rel="me noopener">GitHub</a>
      <a class="hover:text-ink" href={me.blog}>Blog</a>
      <a class="hover:text-ink" href={me.resume}>Résumé</a>
    </footer>
  </main>

  <script is:inline>
    const np = document.getElementById("np");

    // np.vsahni.me only reports a track while one is actually playing
    function show(song) {
      const d = song?.details;
      if (song?.statusCode === 200 && d?.url) {
        const dot = document.createElement("span");
        dot.className = "mr-2 inline-block h-2 w-2 -translate-y-[2px] rounded-full bg-ink motion-safe:animate-pulse";
        dot.title = "Playing now";
        const a = document.createElement("a");
        a.className = "underline decoration-rule decoration-1 underline-offset-[3px] hover:decoration-ink";
        a.href = d.url;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = `${d.name} by ${d.artists.join(", ")}`;
        np.className = "";
        np.replaceChildren(dot, a);
      } else {
        np.className = "italic text-muted";
        np.textContent = "nothing right now";
      }
    }

    async function poll() {
      try {
        const res = await fetch("https://np.vsahni.me", { cache: "no-store" });
        show(await res.json());
      } catch {
        show();
      }
    }

    try {
      const es = new EventSource("https://np.vsahni.me/sse");
      es.onmessage = (e) => show(JSON.parse(e.data));
      es.onerror = () => {
        es.close();
        poll();
      };
    } catch {
      poll();
    }
  </script>
</Layout>
